{
  "name": "steer_delivery",
  "given": {
    "session_exists": true,
    "pending_inbox": 0
  },
  "when": {
    "action": "sessions.prompt",
    "prompt": "urgent fix",
    "delivery": "steer",
    "resume": false
  },
  "then": {
    "inbox_count": 1,
    "history_count": 0,
    "events": ["prompt.admitted"]
  }
}
