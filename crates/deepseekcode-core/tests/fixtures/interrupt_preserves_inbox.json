{
  "name": "interrupt_preserves_inbox",
  "given": {
    "session_exists": true,
    "pending_inbox": 1
  },
  "when": {
    "action": "sessions.interrupt",
    "prompt": "",
    "delivery": "queue",
    "resume": false
  },
  "then": {
    "inbox_count": 1,
    "history_count": 0,
    "events": ["session.interrupted"]
  }
}
