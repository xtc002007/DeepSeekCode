# Code++ release environment (copy to .env and fill in).
# Never commit .env — see signing/README.md for key generation.

# ── Release signing (minisign ed25519) ───────────────────────────────────────
# Generate keys: scripts/release/generate-signing-key.ps1
CODE_PLUS_PLUS_SIGNING_PRIVATE_KEY_PATH=signing/code-plus-plus.key
CODE_PLUS_PLUS_SIGNING_PUBLIC_KEY_PATH=signing/code-plus-plus.key.pub
# Leave empty if the secret key has no password
CODE_PLUS_PLUS_SIGNING_PRIVATE_KEY_PASSWORD=

# GitHub repo for secret upload (scripts/release/set-github-secrets.ps1)
# CODE_PLUS_PLUS_GITHUB_REPO=your-org/code-plus-plus

# ── Optional: Windows Authenticode (installer trust badge) ───────────────────
# Base64-encoded PFX; set in GitHub secret CODE_PLUS_PLUS_WINDOWS_PFX_BASE64
# CODE_PLUS_PLUS_WINDOWS_PFX_PASSWORD=

# ── Optional: future desktop auto-update endpoint ────────────────────────────
# CODE_PLUS_PLUS_UPDATER_ENDPOINT=https://github.com/your-org/code-plus-plus/releases/latest/download/latest.json
# Public key is committed at signing/code-plus-plus.key.pub (minisign format)
