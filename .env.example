# DeepSeekCode release environment (copy to .env and fill in).
# Never commit .env — see signing/README.md for key generation.

# ── Release signing (minisign ed25519) ───────────────────────────────────────
# Generate keys: scripts/release/generate-signing-key.ps1
DEEPSEEKCODE_SIGNING_PRIVATE_KEY_PATH=signing/deepseekcode.key
DEEPSEEKCODE_SIGNING_PUBLIC_KEY_PATH=signing/deepseekcode.key.pub
# Leave empty if the secret key has no password
DEEPSEEKCODE_SIGNING_PRIVATE_KEY_PASSWORD=

# GitHub repo for secret upload (scripts/release/set-github-secrets.ps1)
# DEEPSEEKCODE_GITHUB_REPO=your-org/deepseekcode

# ── Optional: Windows Authenticode (installer trust badge) ───────────────────
# Base64-encoded PFX; set in GitHub secret DEEPSEEKCODE_WINDOWS_PFX_BASE64
# DEEPSEEKCODE_WINDOWS_PFX_PASSWORD=

# ── Optional: future desktop auto-update endpoint ────────────────────────────
# DEEPSEEKCODE_UPDATER_ENDPOINT=https://github.com/your-org/deepseekcode/releases/latest/download/latest.json
# Public key is committed at signing/deepseekcode.key.pub (minisign format)
