# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# SQLite (session / permission stores)
**/*.db
**/*.db-*

# Code++ local runtime (generated)
.code-plus-plus/snapshots/
.code-plus-plus/tool-output/
.code-plus-plus/worktrees/
.code-plus-plus/plugins/*.wasm
.code-plus-plus/plugins/*.dll
.code-plus-plus/plugins/*.so
.code-plus-plus/plugins/*.dylib

# Secrets & local env
.env
.env.*
!.env.example

# Release signing (private keys only — public .pub may be committed)
signing/*.key
signing/*.pfx
!signing/README.md
!signing/*.key.pub

# Desktop packaging staging (generated)
packaging/desktop/windows/staging/
packaging/desktop/windows/dist/

# Logs
logs/
*.log

# Clippy / diagnostic dumps (local only, never commit)
clippy-full.txt
clippy-*.txt

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editors & IDEs
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# Python (test fixtures, scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Profiling / coverage
*.profraw
*.profdata
coverage/
*.gcno
*.gcda

# Cursor agent plans (local scratch)
*.plan.md
vibecodor-update-plan.md

# Secret scan tooling (downloaded by scripts/release/scan-secrets.ps1)
.tools/

# Local upstream reference checkouts (never publish)
third-party-code/
